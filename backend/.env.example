# ─── Server ────────────────────────────────────────────────────────────────
PORT=8080
# Bearer token the mobile app must send (Authorization: Bearer <token>).
# Generate one: `openssl rand -hex 32`
API_AUTH_TOKEN=change-me-to-a-long-random-string

# CORS: comma-separated allowed origins. "*" is fine for local Expo dev.
CORS_ORIGINS=*

# ─── Kalshi ────────────────────────────────────────────────────────────────
# demo | prod   (KEEP THIS ON demo UNTIL EVERYTHING IS VERIFIED)
KALSHI_ENV=demo

# From demo.kalshi.co → Profile → API Keys
KALSHI_API_KEY_ID=

# The RSA private key. Either paste the PEM with literal \n for newlines, e.g.
#   KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
# or base64-encode the whole .pem file and paste that (the client detects which).
KALSHI_PRIVATE_KEY=

# Kalshi series ticker for MLB single-game markets. Verify against the live API
# (GET /series?category=Sports) — Kalshi occasionally renames series.
KALSHI_MLB_SERIES_TICKER=KXMLBGAME

# Safety cap: reject any single order whose notional exceeds this (USD).
MAX_ORDER_NOTIONAL_USD=100
# Safety cap: max orders allowed in one basket (Kalshi batch hard limit is 20).
MAX_BASKET_SIZE=20

# ─── Database (Neon) ─────────────────────────────────────────────────────────
# Leave blank to run without persistence (baskets won't be logged).
DATABASE_URL=
