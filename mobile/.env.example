# Point this at your backend. For Expo Go on a physical phone, use your Mac's
# LAN IP (not localhost) — e.g. http://192.168.1.20:8080. In production use the
# Railway URL. `npm start` reads EXPO_PUBLIC_* vars at bundle time.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Must match the backend's API_AUTH_TOKEN.
# NOTE: this ships inside the app bundle — fine for a personal single-user build.
# When the app goes multi-user, replace with per-user login instead.
EXPO_PUBLIC_API_TOKEN=change-me-to-match-backend
